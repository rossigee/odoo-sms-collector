<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="sms_message_rule_create" model="ir.rule">
        <field name="name">Allow creation of SMS messages</field>
        <field name="model_id" ref="model_sms_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="sms_message_acl_create" model="ir.model.access">
        <field name="name">Allow creation of SMS messages</field>
        <field name="model_id" ref="model_sms_message"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="group_id" eval="ref('base.group_user')"/>
    </record>

    <record id="sms_message_acl_admin" model="ir.model.access">
        <field name="name">Admin full access to SMS messages</field>
        <field name="model_id" ref="model_sms_message"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="group_id" eval="ref('base.group_system')"/>
    </record>

    <record id="sms_device_acl_admin" model="ir.model.access">
        <field name="name">Admin full access to SMS devices</field>
        <field name="model_id" ref="model_sms_device"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="group_id" eval="ref('base.group_system')"/>
    </record>

    <record id="sms_device_acl_user" model="ir.model.access">
        <field name="name">User read access to SMS devices</field>
        <field name="model_id" ref="model_sms_device"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="group_id" eval="ref('base.group_user')"/>
    </record>

    <record id="sms_filter_rule_acl" model="ir.model.access">
        <field name="name">SMS Filter Rule Access</field>
        <field name="model_id" ref="model_sms_filter_rule"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="group_id" eval="ref('base.group_system')"/>
    </record>

    <record id="sms_filter_rule_user_read" model="ir.model.access">
        <field name="name">SMS Filter Rule Read Access</field>
        <field name="model_id" ref="model_sms_filter_rule"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="group_id" eval="ref('base.group_user')"/>
    </record>
</odoo>
