<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sms_message_view_tree" model="ir.ui.view">
            <field name="name">sms.message.view.tree</field>
            <field name="model">sms.message</field>
            <field name="arch" type="xml">
                <tree string="SMS Messages" default_order="date_received desc">
                    <field name="id" optional="hide"/>
                    <field name="date_received" widget="datetime" string="Date Received"/>
                    <field name="address" string="Sender/Recipient"/>
                    <field name="partner_id"/>
                    <field name="phone_user_id"/>
                    <field name="device_id" optional="hide"/>
                    <field name="body" string="Message Body"/>
                    <field name="date_sent" widget="datetime" string="Date Sent" optional="hide"/>
                    <field name="thread_id" string="Thread ID" optional="hide"/>
                    <field name="message_hash" string="Hash" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="sms_message_view_form" model="ir.ui.view">
            <field name="name">sms.message.view.form</field>
            <field name="model">sms.message</field>
            <field name="arch" type="xml">
                <form string="SMS Message">
                    <sheet>
                        <group>
                            <field name="id"/>
                            <field name="idx" string="Internal Index"/>
                            <field name="phone_user_id"/>
                            <field name="device_id"/>
                            <field name="partner_id"/>
                            <field name="address" string="Sender/Recipient"/>
                            <field name="date_sent" widget="datetime" string="Date Sent"/>
                            <field name="date_received" widget="datetime" string="Date Received"/>
                            <field name="thread_id" string="Thread ID"/>
                            <field name="body" string="Message Body"/>
                            <field name="service_center" string="Service Center"/>
                            <field name="message_hash" string="Message Hash" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="sms_message_action" model="ir.actions.act_window">
            <field name="name">SMS Messages</field>
            <field name="res_model">sms.message</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': False}</field>
        </record>

        <menuitem id="menu_sms_message_root" name="SMS Collector"/>
        <menuitem id="menu_sms_message" name="SMS Messages" parent="menu_sms_message_root" action="sms_message_action"/>
    </data>
</odoo>
