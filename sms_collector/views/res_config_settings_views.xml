<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sms.collector</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <div id="contacts_settings" position="after">
                    <h2>SMS Collector</h2>
                    <div class="row mt16 o_settings_container" name="operations_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="sms_collector_minio_endpoint" string="Minio endpoint:" class="col-lg-3 o_light_label"/>
                                        <field name="sms_collector_minio_endpoint" placeholder="minio.domain.com:9000"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="sms_collector_minio_secure" string="Minio uses TLS:" class="col-lg-3 o_light_label"/>
                                        <field name="sms_collector_minio_secure"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="sms_collector_minio_access_key" string="Minio access key:" class="col-lg-3 o_light_label"/>
                                        <field name="sms_collector_minio_access_key"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="sms_collector_minio_secret_key" string="Minio secret key:" class="col-lg-3 o_light_label"/>
                                        <field name="sms_collector_minio_secret_key"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="sms_collector_bucket_name" string="Bucket name:" class="col-lg-3 o_light_label"/>
                                        <field name="sms_collector_bucket_name"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>
