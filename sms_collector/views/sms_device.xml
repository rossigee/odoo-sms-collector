<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sms_device_view_tree" model="ir.ui.view">
            <field name="name">sms.device.view.tree</field>
            <field name="model">sms.device</field>
            <field name="arch" type="xml">
                <tree string="SMS Devices" default_order="last_seen desc">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="platform"/>
                    <field name="last_seen" widget="datetime"/>
                    <field name="message_count" string="Messages"/>
                    <field name="active" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="sms_device_view_form" model="ir.ui.view">
            <field name="name">sms.device.view.form</field>
            <field name="model">sms.device</field>
            <field name="arch" type="xml">
                <form string="SMS Device">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_messages" type="object"
                                    class="oe_stat_button" icon="fa-comments">
                                <field name="message_count" widget="statinfo" string="Messages"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Device Name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="platform"/>
                            </group>
                            <group>
                                <field name="last_seen" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="sms_device_action" model="ir.actions.act_window">
            <field name="name">SMS Devices</field>
            <field name="res_model">sms.device</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <menuitem id="menu_sms_devices"
            name="Devices"
            parent="menu_sms_message_root"
            action="sms_device_action"
            sequence="15"/>
    </data>
</odoo>
